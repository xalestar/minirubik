-    add  t0, s6, a7
+    lw   a4, 8(a4)
+    add  t0, s7, a7
     lhu  a7, 0(t0)
     addi a0, a0, -1
-    bne  a0, t4, catch_R
+    bne  a0, t4, catch_B
     srli t0, a6, 3
     add  t0, t0, a3
     lbu  t0, 12(t0)             # the byte of 4 values
@@ -544,7 +544,7 @@ catch_R:
     andi t0, t0, 3              # the child's distance modulo 3
     add  t0, t0, s1
     lb   s10, 0(t0)
