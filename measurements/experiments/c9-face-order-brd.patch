     j    passed
-next_R:
+next_B:
     addi t4, t4, -1
-    bnez t4, turn_R
-face_B:
-    beq  t6, t3, face_D
+    bnez t4, turn_B
+face_R:
+    beqz t6, face_D
     lw   a2, 0(s4)
     lw   a3, 4(s4)
     lw   a4, 8(s4)
     lhu  a5, 12(s4)
     lhu  a6, 14(s4)
     lhu  a7, 16(s4)
-first_B:
+first_R:
     li   t4, 3
     li   a0, 4
-turn_B:
-    lw   a2, 4(a2)
-    add  t0, s6, a5
+turn_R:
+    lw   a2, 0(a2)
+    add  t0, s5, a5
     lhu  a5, 0(t0)
     srli t0, a5, 3
     add  t0, t0, a2
@@ -582,16 +582,16 @@ turn_B:
     andi t0, t0, 3              # the child's distance modulo 3
     add  t0, t0, s0
     lb   s3, 0(t0)
