     lhu  a6, 14(s4)
     lhu  a7, 16(s4)
-first_R:
+first_B:
     li   t4, 3
     li   a0, 4
-turn_R:
-    lw   a2, 0(a2)
-    add  t0, s5, a5
+turn_B:
+    lw   a2, 4(a2)
+    add  t0, s6, a5
     lhu  a5, 0(t0)
     srli t0, a5, 3
     add  t0, t0, a2
@@ -526,16 +526,16 @@ turn_R:
     andi t0, t0, 3              # the child's distance modulo 3
