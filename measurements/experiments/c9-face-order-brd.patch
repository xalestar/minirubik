+    bltz s3, next_R
+catch_R:
+    lw   a3, 8(a3)
+    add  t0, s7, a6
     lhu  a6, 0(t0)
-    lw   a4, 8(a4)
-    add  t0, s7, a7
+    lw   a4, 4(a4)
+    add  t0, s6, a7
     lhu  a7, 0(t0)
     addi a0, a0, -1
